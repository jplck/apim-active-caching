<!--
  Workers active-cache endpoint. All caching logic lives in the reusable "active-cache"
  policy fragment; this API only declares WHICH backend to pull a full load from.
  Add another cached API the same way: set its own backendUrl, then include the fragment.
-->
<policies>
  <inbound>
    <base />
    <set-variable name="backendUrl" value="{{WorkdayBackendUrl}}" />
    <include-fragment fragment-id="active-cache" />
  </inbound>
  <backend>
    <base />
  </backend>
  <outbound>
    <base />
  </outbound>
  <on-error>
    <base />
  </on-error>
</policies>
