<fragment>
  <!--
    Reusable active-cache fragment. Include from any API's inbound section after
    setting a "backendUrl" variable to that API's Workday source:

      <set-variable name="backendUrl" value="{{SomeBackendUrl}}" />
      <include-fragment fragment-id="active-cache" />

    The cache key is context.Api.Id, so every including API caches under its own
    namespace automatically (no per-API key config). Two paths:
      1. Refresh (X-Refresh-Token gated): full load from backendUrl, cache-store THROUGH
         APIM so read and write share the same (prefixed, undocumented) key namespace.
      2. Read (public): serve from Redis; a MISS returns 503 and never calls Workday.
    Pattern: https://learn.microsoft.com/azure/api-management/api-management-sample-cache-by-key
  -->
  <choose>
    <when condition="@(context.Request.Headers.GetValueOrDefault(&quot;X-Refresh-Token&quot;,&quot;&quot;) == &quot;{{RefreshToken}}&quot;)">
      <send-request mode="new" response-variable-name="workdayResponse" timeout="20" ignore-error="false">
        <set-url>@((string)context.Variables[&quot;backendUrl&quot;])</set-url>
        <set-method>GET</set-method>
      </send-request>
      <set-variable name="workers" value="@(((IResponse)context.Variables[&quot;workdayResponse&quot;]).Body.As&lt;string&gt;())" />
      <cache-store-value key="@(context.Api.Id)" value="@((string)context.Variables[&quot;workers&quot;])" duration="{{CacheTtlSeconds}}" caching-type="external" />
      <return-response>
        <set-status code="200" reason="OK" />
        <set-header name="Content-Type" exists-action="override">
          <value>application/json</value>
        </set-header>
        <set-header name="X-Cache" exists-action="override">
          <value>REFRESHED</value>
        </set-header>
        <set-body>@((string)context.Variables["workers"])</set-body>
      </return-response>
    </when>
  </choose>
  <cache-lookup-value key="@(context.Api.Id)" variable-name="cachedWorkers" caching-type="external" />
  <choose>
    <when condition="@(context.Variables.ContainsKey(&quot;cachedWorkers&quot;))">
      <return-response>
        <set-status code="200" reason="OK" />
        <set-header name="Content-Type" exists-action="override">
          <value>application/json</value>
        </set-header>
        <set-header name="X-Cache" exists-action="override">
          <value>HIT</value>
        </set-header>
        <set-body>@((string)context.Variables["cachedWorkers"])</set-body>
      </return-response>
    </when>
    <otherwise>
      <return-response>
        <set-status code="503" reason="Service Unavailable" />
        <set-header name="Content-Type" exists-action="override">
          <value>application/json</value>
        </set-header>
        <set-header name="X-Cache" exists-action="override">
          <value>MISS</value>
        </set-header>
        <set-header name="Retry-After" exists-action="override">
          <value>60</value>
        </set-header>
        <set-body>{"cached": false, "message": "Workers not in cache yet. The refresher Container Apps Job pre-fills Redis on a schedule."}</set-body>
      </return-response>
    </otherwise>
  </choose>
</fragment>
